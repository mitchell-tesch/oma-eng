# Build artefacts
bin/
obj/
*.dll
*.pdb
*.exe
*.rhp
*.gha

# Editors / OS
.vs/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.user
*.suo
Thumbs.db
.DS_Store

# Rhino / Grasshopper working artefacts
*.rhl
*.3dmbak
*.gh.bak
*.gh_temp
GH_TEMP*
AutoSave*

# VM artefacts (never commit these)
*.qcow2
*.qcow
*.raw
*.iso
*.img
*.vmdk
looking-glass-B*/
looking-glass.tar.gz

# Personal secrets or IDs — these are host-specific and must not be shared
configs/**/*.local
*.local.xml
*.local.conf
license/
*.lic

# Guest-shared drop zones (installers, models, scratch data)
# Guest sees `~/dev/oma-eng/src/` as `Z:\`. These subdirs are for
# transferring binary blobs into the guest — never commit their contents.
src/vendor/
src/scratch/

# Strand7 / FEA working files
*.st7
*.ST7
*.slog
*.SLOG

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node/misc
node_modules/
