<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RhinoToExcel</AssemblyName>
    <RootNamespace>RhinoToExcel</RootNamespace>
    <Version>0.1.0</Version>
    <Title>Rhino → Excel (oma-eng)</Title>
    <Description>Dumps Rhino document object metadata to a new Excel workbook via late-bound COM.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon"     Version="8.*-*" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>
</Project>
