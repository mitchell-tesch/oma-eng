-  app_handleWheelMotion(wl_fixed_to_double(value) / 15.0);
+  // Hi-res wheels and touchpads send fractions of a notch; 15.0 == one notch.
+  static double accum = 0.0;
+  const double delta = wl_fixed_to_double(value);
+  accum += delta;
+
+  while (accum >= 15.0 || accum <= -15.0)
+  {
+    int button = accum > 0 ?
+      5 /* SPICE_MOUSE_BUTTON_DOWN */ :
+      4 /* SPICE_MOUSE_BUTTON_UP */;
+    app_handleButtonPress(button);
+    app_handleButtonRelease(button);
+    accum += accum > 0 ? -15.0 : 15.0;
+  }
+
+  app_handleWheelMotion(delta / 15.0);
 }
 
