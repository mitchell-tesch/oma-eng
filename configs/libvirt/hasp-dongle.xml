<!--
    hasp-dongle.xml — libvirt device XML for hot-attaching a HASP / CmStick
    licence dongle to the running windows-eng guest.

    EDIT the vendor and product IDs to match your dongle (from `lsusb`).
    Common IDs:
      * 0x0529 Sentinel HASP     (Strand7, CSi ETABS/SAP)
      * 0x064f WIBU CmStick      (SpaceGass some builds)

    Hot-attach:
        virsh -c qemu:///system attach-device windows-eng \
            configs/libvirt/hasp-dongle.xml

    Hot-detach:
        virsh -c qemu:///system detach-device windows-eng \
            configs/libvirt/hasp-dongle.xml

    Persistent attachment goes in the main domain XML — see
    configs/libvirt/windows-eng.xml for a matching <hostdev> block.
-->
<hostdev mode='subsystem' type='usb' managed='yes'>
  <source>
    <vendor  id='0x0529'/>
    <product id='0x0001'/>
  </source>
</hostdev>