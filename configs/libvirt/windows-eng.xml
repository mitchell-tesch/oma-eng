<!--
    windows-eng.xml — libvirt domain template for the Windows 11 CAD/FEA guest.

    EDIT every line tagged with "EDIT:" before defining this domain.

    Define with:
        virsh -c qemu:///system define configs/libvirt/windows-eng.xml
        virsh -c qemu:///system start windows-eng

    Layout:
      - 24 GiB memory backed by 1 GiB hugepages (bump for big FEA / Office use)
      - 12 vCPUs pinned to 6 physical cores + hyperthreads (adjust below)
      - Q35 UEFI machine with OVMF, secure boot off (turn on later)
      - virtio-scsi disk + virtio-net + virtio-serial + virtiofs share
      - Nvidia dGPU + audio function passed through (EDIT: PCI addresses)
      - IVSHMEM shared memory for Looking Glass
      - Evdev keyboard/mouse passthrough with LEFTCTRL+RIGHTCTRL toggle
      - SPICE + QXL for install-time display (Looking Glass takes over later)
-->
<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>windows-eng</name>
  <!-- <uuid> intentionally omitted: libvirt auto-generates one at
       `virsh define` time. If you need to pin the UUID for some reason
       (e.g. reproducing a licence lock or a Windows activation ID),
       add the element back and generate a value with `uuidgen`. -->
  <title>Rhino 8 + Strand7 R3 CAD/FEA guest</title>
  <description>Windows 11 with Nvidia dGPU passthrough for CAD/FEA on Omarchy.</description>

  <memory unit='KiB'>33554432</memory>
  <currentMemory unit='KiB'>33554432</currentMemory>
  <!-- Optional <memtune> block. libvirt on Arch/Omarchy accepts
       <locked/> without an explicit hard_limit, but older libvirt
       (< 5.0) refuses. If `virsh define` errors with
       "cannot set memory hard_limit", uncomment and adjust — usually
       set hard_limit slightly above the guest memory to leave room
       for QEMU overhead.
  <memtune>
    <hard_limit unit='KiB'>27262976</hard_limit>
    <soft_limit unit='KiB'>25165824</soft_limit>
  </memtune>
  -->
  <memoryBacking>
    <hugepages>
      <page size='1' unit='G'/>
    </hugepages>
    <access mode='shared'/>
    <nosharepages/>
    <locked/>
  </memoryBacking>

  <!-- Memory sizing:
       * 16 GiB minimum (Rhino only, small Grasshopper defs)
       * 24 GiB comfortable floor for Rhino + Strand7 + Excel/Office
       * 32 GiB+ if you routinely open large FEA models with parallel
         solvers, or big xlsx dashboards driven by Interop.Excel
       * 40+ GiB if Revit joins the daily stack (see docs/12).
       Use scripts/set-guest-memory <GiB> to retarget this element,
       the hugepages sysctl/service, and print the hugepages= value
       for /boot/limine.conf all at once. -->

  <!-- ============================================================
       vCPU count + pinning.

       This block was generated by `scripts/detect-host.sh` with the
       vcpupin flag on HP ZBook Firefly 14 G11 / Intel Core Ultra 7
       165H (Meteor Lake). The 165H is hybrid: 6 P-cores (SMT,
       ~4.7-5.0 GHz) on CPUs 0-11, 8 E-cores (~3.8 GHz) on CPUs 12-19,
       2 LP-E cores (~2.5 GHz) on CPUs 20-21.

       Guest gets 5 P-cores x 2 threads = 10 vCPUs on CPUs 1-4, 6-11.
       Host keeps P-core 0 (CPUs 0, 5) for Hyprland + Looking Glass +
       virtiofsd, plus every E-core and LP-E core for background load.
       Emulator + iothread pin to E-cores 12-13; they handle vCPU
       coordination and disk I/O without stealing cycles from either
       the guest's P-cores or the host's P-core.

       If you swap CPUs, regenerate with the vcpupin flag on
       `scripts/detect-host.sh`.

       General rules of thumb if writing by hand:
         * Give the guest whole physical cores + their SMT/HT siblings.
         * Leave at least 1 physical top-tier core for the host so
           Hyprland/virtiofsd/Looking Glass don't starve.
         * Keep all pinned vCPUs on the same NUMA node / CCD.

       Vendor-specific notes:
         * INTEL hybrid P/E (12th gen+): pin to P-cores only. E-cores
           at a lower MAXMHZ mixed into the guest wreck Windows
           scheduling under CAD/FEA load.
         * AMD RYZEN: keep pinned vCPUs on ONE CCD (`lscpu -e` L3
           column). A 7900X puts CCD0 on CPUs 0..5 + siblings 12..17
           and CCD1 on 6..11 + siblings 18..23.

       Use `lstopo` (from the `hwloc` package) for a visual topology
       map.
       ============================================================ -->

  <vcpu placement='static'>10</vcpu>
  <cputune>
    <vcpupin vcpu='0' cpuset='1'/>
    <vcpupin vcpu='1' cpuset='2'/>
    <vcpupin vcpu='2' cpuset='3'/>
    <vcpupin vcpu='3' cpuset='4'/>
    <vcpupin vcpu='4' cpuset='6'/>
    <vcpupin vcpu='5' cpuset='7'/>
    <vcpupin vcpu='6' cpuset='8'/>
    <vcpupin vcpu='7' cpuset='9'/>
    <vcpupin vcpu='8' cpuset='10'/>
    <vcpupin vcpu='9' cpuset='11'/>
    <emulatorpin cpuset='12,13'/>
    <iothreadpin iothread='1' cpuset='12,13'/>
  </cputune>
  <iothreads>1</iothreads>
  <os firmware='efi'>
    <!-- machine='pc-q35-8.2' pins the QEMU machine model to a specific
         release. On Arch/Omarchy (rolling QEMU) this may print
         "unsupported machine type pc-q35-8.2" a year or two after
         checkout. If define fails with that error, either bump the
         version to what your QEMU actually ships (list with
         `qemu-system-x86_64 -M help | grep q35`) or drop the version
         suffix so libvirt auto-picks the newest. -->
    <type arch='x86_64' machine='pc-q35-8.2'>hvm</type>
    <!-- Windows 11 mandates Secure Boot. `firmware='efi'` + the
         <firmware> feature list make libvirt pick the SB-capable
         OVMF binary from /usr/share/qemu/firmware/*.json (on Arch
         that resolves to OVMF_CODE.secboot.4m.fd + OVMF_VARS.4m.fd)
         — no distro-specific loader path is hard-coded here. SB
         requires SMM, enabled below under <features>.

         `enrolled-keys='no'` reflects that the shipped OVMF_VARS.4m.fd
         has no PK/KEK/db pre-enrolled: the guest boots in Setup Mode,
         which Windows install accepts because SB is advertised as
         enabled. To move to User Mode (Windows-signed binaries only):
         at boot, press Esc → Device Manager → Secure Boot Configuration
         → Enroll All Factory Default Keys → save. Alternatively, use
         `python-virt-firmware` on the host to enroll into the vars file
         before starting the domain (`virt-fw-vars` from the AUR — see
         its help output for the enrollment flag names). -->
    <firmware>
      <feature enabled='no' name='enrolled-keys'/>
      <feature enabled='yes' name='secure-boot'/>
    </firmware>
    <loader secure='yes'/>
    <nvram>/var/lib/libvirt/qemu/nvram/windows-eng_VARS.fd</nvram>
    <!-- Boot order is set per-disk via <boot order='N'/> on the <disk>
         elements below. Do NOT re-add <boot dev='hd'/> here — libvirt
         refuses to define a domain that mixes the two boot-order styles. -->
    <bootmenu enable='yes' timeout='3000'/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
      <vpindex state='on'/>
      <synic state='on'/>
      <stimer state='on'/>
      <reset state='on'/>
      <vendor_id state='on' value='KVMKVMKVM01'/>
      <frequencies state='on'/>
    </hyperv>
    <kvm>
      <hidden state='on'/>
    </kvm>
    <vmport state='off'/>
    <ioapic driver='kvm'/>
    <!-- Required by Secure Boot (OVMF secboot binary refuses to run
         without SMM). Also implicitly enables `smm=on` on the q35
         machine type. -->
    <smm state='on'/>
  </features>

  <!-- CPU: host-passthrough exposes the real CPU to the guest (works
       identically on Intel and AMD).
       * topoext is an AMD-only feature that gives the guest correct
         CCX/CCD topology info. 'optional' == include if the host has
         it, ignore otherwise. Safe on both Intel and AMD hosts.
       * hypervisor bit is masked so Windows doesn't nag about running
         under a hypervisor.
       Pinning topology below assumes 5 P-cores x 2 threads = 10 vCPUs
       to match the <vcpupin> block above (HP ZBook Firefly G11 defaults).
       Intel P/E hybrid CPUs (12th gen+): pin to P-cores only for
       predictable perf; ignore E-cores for the VM.
       AMD Ryzen: keep all pinned vCPUs on the same CCD to avoid
       inter-CCD memory hops. `lscpu -e` shows the CCD/L3 boundaries. -->
  <cpu mode='host-passthrough' check='none' migratable='off'>
    <topology sockets='1' dies='1' cores='5' threads='2'/>
    <cache mode='passthrough'/>
    <feature policy='optional' name='topoext'/>
    <feature policy='disable' name='hypervisor'/>
  </cpu>

  <clock offset='localtime'>
    <timer name='rtc'      tickpolicy='catchup'/>
    <timer name='pit'      tickpolicy='delay'/>
    <timer name='hpet'     present='no'/>
    <timer name='hypervclock' present='yes'/>
    <timer name='tsc' present='yes' mode='native'/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <!-- virtio-scsi controller with dedicated iothread for disk I/O -->
    <controller type='scsi' index='0' model='virtio-scsi'>
      <driver iothread='1' queues='4'/>
    </controller>

    <!-- Primary disk -->
    <!-- EDIT: source file path -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='none' io='native' discard='unmap'/>
      <source file='/var/lib/libvirt/images/windows-eng.qcow2'/>
      <target dev='sda' bus='scsi'/>
      <boot order='1'/>
    </disk>

    <!-- Windows 11 installer ISO (remove after install) -->
    <!-- EDIT: source file path -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/home/CHANGEME/vm-iso/Win11_23H2_English_x64.iso'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
      <boot order='2'/>
    </disk>

    <!-- Virtio driver ISO (keep attached, used for virtiofs guest agent too) -->
    <!-- EDIT: source file path -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/home/CHANGEME/vm-iso/virtio-win.iso'/>
      <target dev='sdc' bus='sata'/>
      <readonly/>
    </disk>

    <!-- Network: NAT'd libvirt default network -->
    <interface type='network'>
      <source network='default'/>
      <model type='virtio'/>
    </interface>

    <!-- Serial + agent -->
    <serial type='pty'><target type='isa-serial' port='0'/></serial>
    <console type='pty'><target type='serial' port='0'/></console>
    <channel type='unix'>
      <source mode='bind'/>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>
    <channel type='spicevmc'>
      <target type='virtio' name='com.redhat.spice.0'/>
    </channel>

    <!-- TPM 2.0 emulated (Windows 11 requirement) -->
    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>

    <!-- IVSHMEM shared memory for Looking Glass.

         Ships commented out on purpose. Two reasons:
           1. Doc 03 uses SPICE for the Windows install and doesn't
              need Looking Glass yet — that's doc 04.
           2. On muxless mobile Optimus cards (RTX Axxx Laptop, most
              gaming laptops) `ivshmem-plain` places the BAR at a
              guest physical address the GPU's DMA engine cannot
              reach, and the domain fails at start with
              `vfio_container_dma_map ... = -22 (Invalid argument)`
              in /var/log/libvirt/qemu/windows-eng.log. Doc 04 §2b
              covers the `kvmfr` kernel-module path that sidesteps
              this on laptops.

         DESKTOP dGPU (full 47-bit DMA): uncomment the block below.
         MUXLESS LAPTOP dGPU: leave this block commented and instead
           uncomment the LG kvmfr <qemu:arg> block at the bottom of
           this file. -->
    <!--
    <shmem name='looking-glass'>
      <model type='ivshmem-plain'/>
      <size unit='M'>128</size>
    </shmem>
    -->

    <!-- Virtiofs shares — one <filesystem> block per host directory to
         expose to the guest. Each block's <target dir='TAG'/> is the
         mount tag the Windows VirtIO-FS Service uses to auto-assign a
         drive letter; the Windows service picks letters in reverse
         (Z:, Y:, X:, ...) so the top-listed share is usually Z:.

         Use scripts/set-guest-share to inspect and edit these blocks
         (add HOST-PATH TAG / remove TAG); see the script header for
         details. -->

    <!-- Primary share: this repo's src/ tree at Z:\ in the guest -->
    <!-- EDIT: source dir absolute path -->
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs' queue='1024'/>
      <binary path='/usr/lib/virtiofsd'>
        <cache mode='always'/>
      </binary>
      <source dir='/home/mzt/dev/oma-eng/src'/>
      <target dir='src'/>
    </filesystem>

    <!-- Secondary share: whole ~/dev/ tree at Y:\ in the guest, so
         sibling repos alongside oma-eng are reachable too. Remove
         this block (or use set-guest-share remove-dev) to skip. -->
    <!-- EDIT: source dir absolute path -->
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs' queue='1024'/>
      <binary path='/usr/lib/virtiofsd'>
        <cache mode='always'/>
      </binary>
      <source dir='/home/mzt/dev'/>
      <target dir='dev'/>
    </filesystem>

    <!-- Nvidia dGPU passthrough.

         DESKTOP CARDS typically expose two functions: VGA (0300) at
         function 0 and HDMI-audio (0403) at function 1. Some also expose
         a USB-C controller (0c03) at function 2. Add one <hostdev> block
         per function. When both VGA and audio are present the VGA block
         needs multifunction='on'.

         MUXLESS MOBILE OPTIMUS cards (e.g. RTX A500 Laptop on the HP
         ZBook Firefly G11 that this template is currently targeting)
         expose only one function: a 3D controller (0302). Only one
         <hostdev> is needed and there is no audio function to bind.
         Guest audio flows through the emulated ich9/HDA device below.

         Run scripts/list-pci-for-passthrough.sh 10de to see what your
         actual card exposes; it prints an advisory when only one
         function is present.

         Guest-side <address> is intentionally omitted; libvirt places
         the device on a suitable pcie-root-port at define time. If you
         need pinned guest topology, add an explicit
         <controller type='pci' index='5' model='pcie-root-port'/> above
         and re-add matching <address bus='0x05' slot='0x00'.../> lines. -->

    <!-- Nvidia dGPU passthrough — 3D controller (only function on muxless).
         EDIT source PCI address to match `lspci -D` on your host. -->
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x0000' bus='0x01' slot='0x00' function='0x0'/>
      </source>
      <rom bar='off'/>
    </hostdev>

    <!-- Desktop card second function (audio). Uncomment and edit source
         address if your card exposes an HDMI-audio function. Also add
         multifunction='on' to the VGA block's guest-side <address> if you
         pin it manually. -->
    <!--
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x0000' bus='0x01' slot='0x00' function='0x1'/>
      </source>
    </hostdev>
    -->

    <!-- Optional: HASP / dongle passthrough for licenced apps.
         Each licence dongle appears as a separate USB device on the
         Omarchy host (`lsusb`). Uncomment one block per dongle and
         fill in its vendor/product ID. Common vendors:
           * Sentinel HASP  vendor=0x0529   (Strand7, CSi ETABS/SAP)
           * WIBU CmStick   vendor=0x064f   (SpaceGass some builds)
         See docs/07-strand7-setup.md and docs/11-etabs-and-spacegass.md
         for the licence-runtime setup inside the guest.
         Network licence servers (Reprise for CSi, hasplm, etc.) are an
         alternative — the guest reaches them over virtio-net and no
         passthrough is required. -->
    <!--
    <hostdev mode='subsystem' type='usb' managed='yes'>
      <source>
        <vendor  id='0x0529'/>
        <product id='0x0001'/>
      </source>
    </hostdev>
    -->
    <!-- More dongles: duplicate the block above with different IDs. -->

    <!-- Install-time SPICE display + QXL video. Once Looking Glass is set
         up, you can leave both in place: QXL stays disabled in Device
         Manager, SPICE is used for occasional recovery. -->
    <graphics type='spice' autoport='yes'>
      <listen type='address' address='127.0.0.1'/>
      <image compression='off'/>
      <gl enable='no'/>
    </graphics>
    <video>
      <model type='qxl' ram='65536' vram='65536' vgamem='16384' heads='1' primary='yes'/>
    </video>

    <!-- Sound: intel-hda so Windows audio works before Nvidia HDMI takes over -->
    <sound model='ich9'/>

    <memballoon model='virtio'/>
  </devices>

  <!--
      Evdev keyboard+mouse passthrough with LEFT-CTRL+RIGHT-CTRL toggle,
      plus optional Looking Glass IVSHMEM overrides for muxless dGPUs.

      Native libvirt XML support for evdev is limited, so we drop into
      qemu: commandline. EDIT the by-id paths for your actual keyboard
      and mouse. Enumerate with: ls -la /dev/input/by-id/

      LOOKING GLASS ON A MUXLESS LAPTOP dGPU (see doc 04 §2b): uncomment
      the LG kvmfr block below. Prereqs on the host: install
      `looking-glass-module-dkms` (AUR); autoload kvmfr with
      `static_size_mb=128`; drop a udev rule making /dev/kvmfr0
      root:kvm 0660; add /dev/kvmfr0 to /etc/libvirt/qemu.conf's
      cgroup_device_acl. In the guest: install the matching Looking
      Glass B7 host-app and the Virtual Display Driver (VDD).
  -->
  <qemu:commandline>
    <qemu:arg value='-object'/>
    <qemu:arg value='input-linux,id=kbd1,evdev=/dev/input/by-id/usb-CHANGEME-event-kbd,grab_all=on,repeat=on'/>
    <qemu:arg value='-object'/>
    <qemu:arg value='input-linux,id=mouse1,evdev=/dev/input/by-id/usb-CHANGEME-event-mouse'/>
    <!-- LG kvmfr overrides (muxless laptop dGPU). Uncomment as a
         unit; see doc 04 §2b for what each line does.
         X-PciMmio64Mb=32768 caps OVMF's 64-bit BAR window at 32 GiB
         so it fits under Intel VT-d's 42-bit aperture on Meteor Lake.
         addr=0x10 avoids the QXL slot on pcie.0. -->
    <!--
    <qemu:arg value='-fw_cfg'/>
    <qemu:arg value='name=opt/ovmf/X-PciMmio64Mb,string=32768'/>
    <qemu:arg value='-device'/>
    <qemu:arg value='ivshmem-plain,memdev=looking-glass,bus=pcie.0,addr=0x10'/>
    <qemu:arg value='-object'/>
    <qemu:arg value='memory-backend-file,id=looking-glass,mem-path=/dev/kvmfr0,size=128M,share=yes'/>
    -->
  </qemu:commandline>
</domain>
