# Default: normalise text file endings on checkin
* text=auto

# Unix-destined files must stay LF regardless of clone platform
*.sh          text eol=lf
scripts/*     text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
*.ini         text eol=lf
*.xml         text eol=lf
*.py          text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# libvirt hook scripts have no extension by convention
configs/libvirt/hooks/*   text eol=lf

# Windows-destined C# code can be CRLF locally, but repo canonical is LF
*.cs          text eol=lf
*.csproj      text eol=lf

# Binary
*.qcow2       binary
*.iso         binary
*.rhp         binary
*.gha         binary
*.dll         binary
