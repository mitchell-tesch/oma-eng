#!/usr/bin/env bash
# set-guest-memory — atomically retarget guest RAM across every file
# that duplicates the number, apply the change live where safe, and
# print the one bootloader step that has to stay manual.
#
# The guest memory size is quietly duplicated in five places:
#   - configs/libvirt/windows-eng.xml            (<memory>, <currentMemory>, KiB)
#   - configs/sysctl.d/99-vm-hugepages.conf      (vm.nr_hugepages — repo template)
#   - configs/systemd/hugepages.service          (echo N > ..., fallback unit)
#   - /etc/sysctl.d/99-vm-hugepages.conf         (installed drop-in — must stay in
#                                                 sync or systemd-sysctl trims at boot)
#   - libvirt persistent config for windows-eng  (setmaxmem/setmem --config)
#
# Plus the kernel command line in /boot/limine.conf (`hugepages=N`).
# By default this helper edits the three repo files, `sudo cp`s the sysctl
# drop-in into place and reloads it, and updates the libvirt persistent
# config (setmaxmem/setmem for a defined domain, `virsh define` for a
# fresh install). limine.conf stays manual by design — the bootloader
# lives outside the repo, and the kernel only reserves the new page count
# at boot.
#
# Usage:
#     scripts/set-guest-memory 32                  # sync repo + host + libvirt
#     scripts/set-guest-memory 32 --no-apply       # sync repo only, print host steps
#     scripts/set-guest-memory 32 --dry-run        # show the diffs, change nothing
#     scripts/set-guest-memory --status            # show current values
#     scripts/set-guest-memory --help
#
# Safe to re-run; every edit is idempotent and only touches the exact
# numeric field, leaving comments and formatting untouched.
#
# CAP:  guest memory in GiB, integer, in [8, 512].

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
XML="$REPO_ROOT/configs/libvirt/windows-eng.xml"
SYSCTL="$REPO_ROOT/configs/sysctl.d/99-vm-hugepages.conf"
SVC="$REPO_ROOT/configs/systemd/hugepages.service"

usage() {
    sed -n '2,32p' "$0"
    exit "${1:-0}"
}

dry=0
show_status=0
no_apply=0
gib=""
for arg in "$@"; do
    case "$arg" in
        -h|--help)    usage 0 ;;
        --dry-run)    dry=1 ;;
        --status)     show_status=1 ;;
        --no-apply)   no_apply=1 ;;
        [0-9]*)       gib="$arg" ;;
        *)            echo "Unknown arg: $arg" >&2; usage 2 ;;
    esac
done

for f in "$XML" "$SYSCTL" "$SVC"; do
    if [[ ! -f "$f" ]]; then
        printf 'Missing repo file: %s\n' "$f" >&2
        printf 'Run this script from a checked-out oma-eng tree.\n' >&2
        exit 1
    fi
done

# --- --status short-circuit ------------------------------------------------

current_kib="$(sed -n "s|.*<memory unit='KiB'>\([0-9]\+\)</memory>.*|\1|p" "$XML" | head -n1)"
current_sysctl="$(sed -n 's|^vm\.nr_hugepages = \([0-9]\+\).*|\1|p' "$SYSCTL" | head -n1)"
current_svc="$(sed -n "s|.*echo \([0-9]\+\) > /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages.*|\1|p" "$SVC" | head -n1)"

if [[ $show_status -eq 1 ]]; then
    if [[ -n "$current_kib" ]]; then
        printf 'windows-eng.xml <memory>       : %d KiB (%.1f GiB)\n' \
            "$current_kib" "$(awk -v k="$current_kib" 'BEGIN{print k/1024/1024}')"
    else
        printf 'windows-eng.xml <memory>       : (not found)\n'
    fi
    printf '99-vm-hugepages.conf           : %s x 1 GiB pages\n' "${current_sysctl:-(not found)}"
    printf 'hugepages.service              : %s x 1 GiB pages\n'  "${current_svc:-(not found)}"
    exit 0
fi

# --- Validation -----------------------------------------------------------

if [[ -z "$gib" ]]; then
    echo "Missing memory size (in GiB). Try:  scripts/set-guest-memory 32" >&2
    usage 2
fi

if ! [[ "$gib" =~ ^[0-9]+$ ]]; then
    echo "Memory size must be a positive integer of GiB, got: $gib" >&2
    exit 2
fi

if (( gib < 8 )); then
    echo "Refusing to set guest memory below 8 GiB — none of the CAD apps" >&2
    echo "run happily on less." >&2
    exit 2
fi

if (( gib > 512 )); then
    echo "Refusing to set guest memory above 512 GiB. Did you mean MiB?" >&2
    exit 2
fi

target_kib=$(( gib * 1024 * 1024 ))
target_pages=$gib

printf 'Target: %d GiB (%d KiB, %d x 1 GiB hugepages)\n\n' \
    "$gib" "$target_kib" "$target_pages"

# --- Edits -----------------------------------------------------------------
# Portable sed: use -E for extended regex, keep BSD-safe patterns.
# Each edit only touches the specific numeric field, so re-runs are idempotent.

edit_xml() {
    sed -E -e "s|<memory unit='KiB'>[0-9]+</memory>|<memory unit='KiB'>${target_kib}</memory>|" \
           -e "s|<currentMemory unit='KiB'>[0-9]+</currentMemory>|<currentMemory unit='KiB'>${target_kib}</currentMemory>|" \
           "$1"
}
edit_sysctl() {
    sed -E "s|^vm\.nr_hugepages = [0-9]+|vm.nr_hugepages = ${target_pages}|" "$1"
}
edit_svc() {
    # Only touch the ExecStart line — ExecStop must stay `echo 0`
    # so the pages are released when the service stops.
    sed -E "/^ExecStart=/ s|(echo )[0-9]+( > /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages)|\1${target_pages}\2|" "$1"
}

if [[ $dry -eq 1 ]]; then
    echo "=== $XML ==="
    diff -u "$XML"    <(edit_xml    "$XML")    || true
    echo
    echo "=== $SYSCTL ==="
    diff -u "$SYSCTL" <(edit_sysctl "$SYSCTL") || true
    echo
    echo "=== $SVC ==="
    diff -u "$SVC"    <(edit_svc    "$SVC")    || true
    echo
    echo "(dry run — no files modified)"
else
    tmp="$(mktemp)"
    for f in "$XML" "$SYSCTL" "$SVC"; do
        case "$f" in
            "$XML")    edit_xml    "$f" > "$tmp" ;;
            "$SYSCTL") edit_sysctl "$f" > "$tmp" ;;
            "$SVC")    edit_svc    "$f" > "$tmp" ;;
        esac
        if cmp -s "$tmp" "$f"; then
            printf '  ok  %s (already at target)\n' "$f"
        else
            mv "$tmp" "$f"
            tmp="$(mktemp)"
            printf '  new %s\n' "$f"
        fi
    done
    rm -f "$tmp"
fi

# --- Live application (sysctl drop-in + libvirt persistent config) --------
# The three repo edits above only affect files inside the working tree.
# For the change to take effect on THIS host we also need to:
#   - copy the sysctl drop-in into /etc/sysctl.d/ and reload it, else
#     systemd-sysctl trims nr_hugepages back at every boot
#   - update the libvirt persistent config: setmaxmem/setmem for a
#     defined domain (avoids the UUID conflict on `virsh define`),
#     or `virsh define` for a fresh install
#   - edit /boot/limine.conf by hand and reboot (still manual)

INSTALLED_SYSCTL="/etc/sysctl.d/99-vm-hugepages.conf"
DOMAIN="windows-eng"
VIRSH="virsh --connect qemu:///system"

apply=1
if (( dry )) || (( no_apply )); then
    apply=0
fi

echo
printf '=== Live host state ===\n'

# --- sysctl drop-in --------------------------------------------------------

if [[ -f "$INSTALLED_SYSCTL" ]]; then
    if cmp -s "$SYSCTL" "$INSTALLED_SYSCTL"; then
        printf '  ok  %s (already in sync)\n' "$INSTALLED_SYSCTL"
    elif (( apply )); then
        printf '  cp  %s (sudo)\n' "$INSTALLED_SYSCTL"
        sudo install -m 644 "$SYSCTL" "$INSTALLED_SYSCTL"
        sudo sysctl --system > /dev/null
        printf '  ok  nr_hugepages applied (%d x 1 GiB)\n' "$target_pages"
    else
        printf '  drift %s differs from repo (would sudo cp + sysctl --system)\n' "$INSTALLED_SYSCTL"
    fi
else
    printf '  --- %s not installed (kernel-cmdline-only path, nothing to sync)\n' "$INSTALLED_SYSCTL"
fi

# --- libvirt persistent config --------------------------------------------

if ! command -v virsh >/dev/null 2>&1; then
    printf '  --- virsh not on PATH; skipping libvirt sync\n'
elif ! $VIRSH dominfo "$DOMAIN" >/dev/null 2>&1; then
    if (( apply )); then
        printf '  def %s (fresh install, virsh define from repo XML)\n' "$DOMAIN"
        $VIRSH define "$XML"
    else
        printf '  new %s not defined; would run: %s define %s\n' \
            "$DOMAIN" "$VIRSH" "$XML"
    fi
else
    dom_state=$($VIRSH domstate "$DOMAIN" 2>/dev/null || echo unknown)
    dom_kib=$($VIRSH dominfo "$DOMAIN" | sed -n 's|^Max memory:[[:space:]]*\([0-9]\+\).*|\1|p')
    if [[ "$dom_kib" == "$target_kib" ]]; then
        printf '  ok  libvirt %s already at %d KiB (%s)\n' "$DOMAIN" "$target_kib" "$dom_state"
    elif [[ "$dom_state" == "running" ]]; then
        printf '  --- libvirt %s is running at %s KiB; cannot change max memory\n' \
            "$DOMAIN" "$dom_kib"
        printf '      shut down the guest first, then re-run this script:\n'
        printf '          %s shutdown %s\n' "$VIRSH" "$DOMAIN"
    elif (( apply )); then
        printf '  set %s max/current memory to %d KiB (--config)\n' \
            "$DOMAIN" "$target_kib"
        $VIRSH setmaxmem "$DOMAIN" "$target_kib" --config
        $VIRSH setmem    "$DOMAIN" "$target_kib" --config
    else
        printf '  drift libvirt %s at %s KiB; would run:\n' "$DOMAIN" "$dom_kib"
        printf '          %s setmaxmem %s %d --config\n' "$VIRSH" "$DOMAIN" "$target_kib"
        printf '          %s setmem    %s %d --config\n' "$VIRSH" "$DOMAIN" "$target_kib"
    fi
fi

# --- limine.conf reminder (bootloader — always manual) --------------------

cat <<EOF

Manual follow-up — /boot/limine.conf (bootloader, outside the repo):

  Edit /boot/limine.conf. On the main Omarchy Linux entry's 'cmdline:'
  line, replace any existing 'hugepages=NN' token with:

      hugepages=${target_pages}

  Full cmdline snippet for a fresh install (adjust intel_iommu /
  amd_iommu as your CPU requires — 'scripts/detect-host.sh --cmdline'
  prints the right one):

      intel_iommu=on iommu=pt default_hugepagesz=1G hugepagesz=1G hugepages=${target_pages}

  Then reboot to reserve the hugepages at boot:

      sudo systemctl reboot

  Verify:

      grep Huge /proc/meminfo
      # HugePages_Total should be ${target_pages}

EOF
