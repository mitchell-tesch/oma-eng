#!/usr/bin/env bash
# set-guest-memory — retarget guest RAM everywhere it matters on THIS
# host, apply it live where safe, and print the one bootloader step that
# has to stay manual.
#
# Edits and syncs:
#   - configs/libvirt/windows-eng.local.xml   (<memory>, <currentMemory>)
#     Your machine's copy, gitignored; created from the tracked template
#     windows-eng.xml on first run. Tracked files are never edited.
#   - /etc/sysctl.d/99-vm-hugepages.conf      (vm.nr_hugepages, if installed;
#     rendered from the repo template so systemd-sysctl can't trim at boot)
#   - libvirt persistent config for windows-eng (setmaxmem/setmem --config,
#     or `virsh define` of the local XML for a fresh install)
#
# The kernel cmdline `hugepages=N` stays manual: re-run
# `sudo scripts/set-cmdline` (it reads N from the local XML) and reboot.
#
# Usage:
#     scripts/set-guest-memory 32                  # sync local XML + host + libvirt
#     scripts/set-guest-memory 32 --no-apply       # local XML only, print host steps
#     scripts/set-guest-memory 32 --dry-run        # show the diff, change nothing
#     scripts/set-guest-memory --status            # show current values
#     scripts/set-guest-memory --help
#
# Safe to re-run; every edit is idempotent and only touches the exact
# numeric field, leaving comments and formatting untouched.
#
# CAP:  guest memory in GiB, integer, in [8, 512].

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TEMPLATE="$REPO_ROOT/configs/libvirt/windows-eng.xml"
XML="$REPO_ROOT/configs/libvirt/windows-eng.local.xml"
SYSCTL="$REPO_ROOT/configs/sysctl.d/99-vm-hugepages.conf"
INSTALLED_SYSCTL="/etc/sysctl.d/99-vm-hugepages.conf"
DOMAIN="windows-eng"
VIRSH="virsh --connect qemu:///system"

usage() {
    sed -n '2,28p' "$0"
    exit "${1:-0}"
}

dry=0
show_status=0
no_apply=0
gib=""
for arg in "$@"; do
    case "$arg" in
        -h|--help)    usage 0 ;;
        --dry-run)    dry=1 ;;
        --status)     show_status=1 ;;
        --no-apply)   no_apply=1 ;;
        [0-9]*)       gib="$arg" ;;
        *)            echo "Unknown arg: $arg" >&2; usage 2 ;;
    esac
done

for f in "$TEMPLATE" "$SYSCTL"; do
    if [[ ! -f "$f" ]]; then
        printf 'Missing repo file: %s\n' "$f" >&2
        printf 'Run this script from a checked-out oma-eng tree.\n' >&2
        exit 1
    fi
done

# --- --status short-circuit ------------------------------------------------

src_xml="$XML"; [[ -f "$XML" ]] || src_xml="$TEMPLATE"
current_kib="$(sed -n "s|.*<memory unit='KiB'>\([0-9]\+\)</memory>.*|\1|p" "$src_xml" | head -n1)"

if [[ $show_status -eq 1 ]]; then
    printf '%-34s: %s GiB\n' "$(basename "$src_xml") <memory>" "$(( ${current_kib:-0} / 1048576 ))"
    [[ -f "$XML" ]] || printf '%-34s  (no local copy yet — created on first change)\n' ''
    printf '%-34s: %s\n' "$INSTALLED_SYSCTL" \
        "$(sed -n 's|^vm\.nr_hugepages = \([0-9]\+\).*|\1 pages|p' "$INSTALLED_SYSCTL" 2>/dev/null || true)"
    printf '%-34s: %s\n' 'running kernel cmdline' \
        "$(grep -oE '\bhugepages=[0-9]+' /proc/cmdline || echo '(no hugepages=)')"
    printf '%-34s: %s\n' "libvirt $DOMAIN max memory" \
        "$($VIRSH dominfo "$DOMAIN" 2>/dev/null | sed -n 's|^Max memory:[[:space:]]*||p' || true)"
    exit 0
fi

# --- Validation -----------------------------------------------------------

if [[ -z "$gib" ]]; then
    echo "Missing memory size (in GiB). Try:  scripts/set-guest-memory 32" >&2
    usage 2
fi

if ! [[ "$gib" =~ ^[0-9]+$ ]]; then
    echo "Memory size must be a positive integer of GiB, got: $gib" >&2
    exit 2
fi

if (( gib < 8 )); then
    echo "Refusing to set guest memory below 8 GiB — none of the CAD apps" >&2
    echo "run happily on less." >&2
    exit 2
fi

if (( gib > 512 )); then
    echo "Refusing to set guest memory above 512 GiB. Did you mean MiB?" >&2
    exit 2
fi

target_kib=$(( gib * 1024 * 1024 ))
target_pages=$gib

printf 'Target: %d GiB (%d KiB, %d x 1 GiB hugepages)\n\n' \
    "$gib" "$target_kib" "$target_pages"

# --- Edits -----------------------------------------------------------------
# Portable sed: use -E for extended regex, keep BSD-safe patterns.
# Each edit only touches the specific numeric field, so re-runs are idempotent.

edit_xml() {
    sed -E -e "s|<memory unit='KiB'>[0-9]+</memory>|<memory unit='KiB'>${target_kib}</memory>|" \
           -e "s|<currentMemory unit='KiB'>[0-9]+</currentMemory>|<currentMemory unit='KiB'>${target_kib}</currentMemory>|" \
           "$1"
}
render_sysctl() {
    sed -E "s|^vm\.nr_hugepages = [0-9]+|vm.nr_hugepages = ${target_pages}|" "$SYSCTL"
}

if [[ $dry -eq 1 ]]; then
    echo "=== $XML ==="
    diff -u "$src_xml" <(edit_xml "$src_xml") || true
    echo
    echo "(dry run — no files modified)"
else
    if [[ ! -f "$XML" ]]; then
        cp "$TEMPLATE" "$XML"
        printf '  new %s (copied from the template; gitignored)\n' "$XML"
    fi
    tmp="$(mktemp)"
    edit_xml "$XML" > "$tmp"
    if cmp -s "$tmp" "$XML"; then
        printf '  ok  %s (already at target)\n' "$XML"
        rm -f "$tmp"
    else
        mv "$tmp" "$XML"
        printf '  new %s\n' "$XML"
    fi
fi

# --- Live application (sysctl drop-in + libvirt persistent config) --------

apply=1
if (( dry )) || (( no_apply )); then
    apply=0
fi

echo
printf '=== Live host state ===\n'

# --- sysctl drop-in --------------------------------------------------------

if [[ -f "$INSTALLED_SYSCTL" ]]; then
    installed_pages="$(sed -n 's|^vm\.nr_hugepages = \([0-9]\+\).*|\1|p' "$INSTALLED_SYSCTL" | head -n1)"
    if [[ "$installed_pages" == "$target_pages" ]]; then
        printf '  ok  %s (vm.nr_hugepages = %d)\n' "$INSTALLED_SYSCTL" "$target_pages"
    elif (( apply )); then
        printf '  cp  %s (sudo)\n' "$INSTALLED_SYSCTL"
        render_sysctl | sudo install -m 644 /dev/stdin "$INSTALLED_SYSCTL"
        sudo sysctl --system > /dev/null
        printf '  ok  nr_hugepages applied (%d x 1 GiB)\n' "$target_pages"
    else
        printf '  drift %s has %s pages (would sudo install + sysctl --system)\n' \
            "$INSTALLED_SYSCTL" "${installed_pages:-no}"
    fi
else
    printf '  --- %s not installed (kernel-cmdline-only path, nothing to sync)\n' "$INSTALLED_SYSCTL"
fi

# --- libvirt persistent config --------------------------------------------

if ! command -v virsh >/dev/null 2>&1; then
    printf '  --- virsh not on PATH; skipping libvirt sync\n'
elif ! $VIRSH dominfo "$DOMAIN" >/dev/null 2>&1; then
    if (( apply )) && [[ -f "$XML" ]]; then
        printf '  def %s (fresh install, virsh define from local XML)\n' "$DOMAIN"
        $VIRSH define "$XML"
    else
        printf '  new %s not defined; would run: %s define %s\n' \
            "$DOMAIN" "$VIRSH" "$XML"
    fi
else
    dom_state=$($VIRSH domstate "$DOMAIN" 2>/dev/null || echo unknown)
    dom_kib=$($VIRSH dominfo "$DOMAIN" | sed -n 's|^Max memory:[[:space:]]*\([0-9]\+\).*|\1|p')
    if [[ "$dom_kib" == "$target_kib" ]]; then
        printf '  ok  libvirt %s already at %d KiB (%s)\n' "$DOMAIN" "$target_kib" "$dom_state"
    elif [[ "$dom_state" == "running" ]]; then
        printf '  --- libvirt %s is running at %s KiB; cannot change max memory\n' \
            "$DOMAIN" "$dom_kib"
        printf '      shut down the guest first, then re-run this script:\n'
        printf '          %s shutdown %s\n' "$VIRSH" "$DOMAIN"
    elif (( apply )); then
        printf '  set %s max/current memory to %d KiB (--config)\n' \
            "$DOMAIN" "$target_kib"
        $VIRSH setmaxmem "$DOMAIN" "$target_kib" --config
        $VIRSH setmem    "$DOMAIN" "$target_kib" --config
    else
        printf '  drift libvirt %s at %s KiB; would run:\n' "$DOMAIN" "$dom_kib"
        printf '          %s setmaxmem %s %d --config\n' "$VIRSH" "$DOMAIN" "$target_kib"
        printf '          %s setmem    %s %d --config\n' "$VIRSH" "$DOMAIN" "$target_kib"
    fi
fi

# --- Kernel cmdline reminder (bootloader — needs root + reboot) -----------

if grep -qE "\bhugepages=${target_pages}\b" /proc/cmdline; then
    printf '  ok  running kernel already reserves hugepages=%d\n' "$target_pages"
    exit 0
fi

cat <<EOF

Manual follow-up — reserve the new page count at boot:

    sudo scripts/set-cmdline          # reads hugepages=${target_pages} from the local XML
    sudo systemctl reboot

Verify:

    grep HugePages_Total /proc/meminfo   # should be ${target_pages}

EOF
