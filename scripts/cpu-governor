#!/usr/bin/env bash
# cpu-governor — set the CPU frequency governor system-wide.
#
# Usage:
#     sudo cpu-governor performance     # for CAD/FEA use
#     sudo cpu-governor powersave       # intel_pstate / amd-pstate default
#     sudo cpu-governor schedutil       # acpi-cpufreq default
#     sudo cpu-governor status          # show current + available
#
# Only governors listed in scaling_available_governors are accepted;
# intel_pstate in active mode offers just performance and powersave.
#
# configs/libvirt/hooks/qemu calls this around guest start/stop when
# power-profiles-daemon is not installed.

set -euo pipefail

cmd="${1:-status}"
available="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors)"

case "$cmd" in
    status)
        for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            printf "%-40s %s\n" "$c" "$(cat "$c")"
        done | column -t
        echo "available: $available"
        exit 0
        ;;
    *)
        if [[ " $available " != *" $cmd "* ]]; then
            echo "Governor not available: $cmd (available: $available)" >&2
            exit 2
        fi
        gov="$cmd" ;;
esac

if [[ $EUID -ne 0 ]]; then
    echo "This command must run as root." >&2
    exit 1
fi

for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    echo "$gov" > "$c"
done

echo "Set all CPUs to governor: $gov"
